# Maintainer: Yangtse Su <yangtsesu at gmail dot com>
# SPDX-FileCopyrightText: 2026 Yangtse Su <yangtsesu@gmail.com>
# SPDX-License-Identifier: 0BSD
#
# The `-git` suffix means this package tracks the tip of the `master` branch. Upstream publishes no
# tags and no releases, so `pkgver()` counts commits on that branch. `makepkg -C --noconfirm`
# re-clones it and picks up new commits (`-e` would silently keep the old checkout).
#
# The package ships two binaries:
#   monitor-control  upstream: get or set one VCP feature on one output, one DDC frame, no scan
#   monitor-input    a wrapper that selects the input source (VCP 0x60) of one monitor
#
# monitor-control opens /dev/i2c-<n>, which the kernel creates as root:root 0600. The package
# therefore installs 60-monitor-control-i2c.rules, which tags the buses with uaccess so that
# systemd-logind grants an ACL to the active local session user; ddcutil is not needed for this and
# is not a dependency. pacman's udev hook only reloads rule files, so the .install scriptlet
# re-triggers the i2c devices to apply the ACL without a reboot.
#
# Verified with:
#   namcap PKGBUILD
#   makepkg -f && namcap monitor-control-git-*.pkg.tar.zst
#   udevadm verify 60-monitor-control-i2c.rules
#   monitor-control DP-1 0x60        # prints "<value> <max>", 15 on the VG249 while DP is active
#   monitor-input status             # prints "DisplayPort-1"
#
# monitor-input ships with the VCP 0x60 values of one monitor (ASUS VG249: 15 DisplayPort-1,
# 17 HDMI-1, 1 VGA-1) and the output that carries its DDC channel (DP-1). Values are monitor
# specific and cannot be derived without reading capabilities, which monitor-control deliberately
# does not do, so another monitor or host is configured in ~/.config/monitor-input.conf:
#   MONITOR_OUTPUT=HDMI-A-1   MONITOR_HDMI=17   MONITOR_DP=15   MONITOR_VGA=1
# Environment variables take precedence over that file, and the file over the defaults.

pkgname=monitor-control-git
pkgver=r15.d8efd61
pkgrel=1
pkgdesc='Fastest tool to get and set DDC/CI monitor values, plus an input-source switcher'
arch=('x86_64' 'aarch64')
url='https://github.com/lilydjwg/monitor-control'
license=('GPL-3.0-only')
depends=('bash' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'rust')
provides=('monitor-control')
conflicts=('monitor-control')
options=('!lto' '!debug')
install=$pkgname.install

source=("$pkgname::git+https://github.com/lilydjwg/monitor-control.git"
        'monitor-input'
        '60-monitor-control-i2c.rules')
sha256sums=('SKIP'
            '979cc8e6fa0d8b407b2229174edd14569cd267f5ebfd5376e2cbd9cca2cc73ae'
            'e8786e2c249497ecc08bbd156ee6429d1db8c0fd403914be0009accc6b390fe6')

pkgver() {
  cd "$pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$pkgname"
  cargo build --release --locked --target "${CARCH}-unknown-linux-gnu"
}

package() {
  cd "$pkgname"

  install -Dm755 "target/${CARCH}-unknown-linux-gnu/release/monitor-control" \
    "$pkgdir/usr/bin/monitor-control"
  install -Dm755 "$srcdir/monitor-input" "$pkgdir/usr/bin/monitor-input"
  install -Dm644 "$srcdir/60-monitor-control-i2c.rules" \
    "$pkgdir/usr/lib/udev/rules.d/60-monitor-control-i2c.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
