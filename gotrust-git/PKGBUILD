# Builds the tip of the local goTrust checkout on branch main. makepkg runs git
# with GIT_CONFIG_GLOBAL=/dev/null, so a private GitHub HTTPS clone cannot use
# the user's credential helper; the local file source is the working path for
# this self-use package. When the repository is public, switch the source to
# git+https://github.com/YangtseSu/goTrust.git#branch=main. The packaged program
# is AGPL-3.0-or-later; the packaging files are 0BSD.
#
# Verified with:
#   namcap PKGBUILD
#   makepkg -f && namcap gotrust-git-*.pkg.tar.zst
#
# namcap keeps two kinds of warning, both intentional:
#   * libdl/libpthread "unused" and glibc "implicitly satisfied" come from the
#     external linker; glibc is listed explicitly for clarity.
#   * gtk3 and libayatana-appindicator are loaded with purego at runtime, so
#     namcap cannot see them as needed; removing them breaks the window/tray.

pkgname=gotrust-git
pkgver=r7.g2bb630c
pkgrel=1
pkgdesc='Tray app for Sangfor aTrust gateways with local SOCKS5 and HTTP proxies'
arch=('x86_64' 'aarch64')
url='https://github.com/YangtseSu/goTrust'
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
makedepends=('gcc' 'git' 'go')
provides=('gotrust')
conflicts=('gotrust')
options=('!debug')
_branch=main
source=("$pkgname::git+file://$HOME/projects/goTrust#branch=$_branch"
        'goTrust.desktop'
        'goTrust.png'
        'goTrust-32.png')
sha256sums=('SKIP'
            'ae92337d44640170cd62fca6d5af59b4d0ea3030753bba68087c09aa611b2e2c'
            'cc2b8210df45e73acd61f32dd310dd18705128a1d762830883a7a8a43d5733d7'
            '249ce925943e1520de3f21d9dd0c646ece0e977d7aa89bc1bc29a40947980456')

prepare() {
  cd "$pkgname"
  # Fetch modules here so build() needs no network: a clean chroot has none
  # once checksumming and cloning are done.
  go mod download
}

pkgver() {
  cd "$pkgname"
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$pkgname"
  # cgo is only for the external linker, which applies FULL RELRO; the app
  # loads GTK and the tray through purego, so no cgo code runs.
  export CGO_ENABLED=1
  go build \
    -trimpath \
    -buildmode=pie \
    -ldflags "-s -w -linkmode=external -extldflags=-Wl,-z,relro,-z,now" \
    -o goTrust \
    .
}

check() {
  cd "$pkgname"
  go test ./...
}

package() {
  cd "$pkgname"
  install -Dm755 goTrust "$pkgdir/usr/bin/goTrust"

  install -Dm644 "$srcdir/goTrust.desktop" \
    "$pkgdir/usr/share/applications/goTrust.desktop"
  install -Dm644 "$srcdir/goTrust.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/goTrust.png"
  install -Dm644 "$srcdir/goTrust-32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/goTrust.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
