# Maintainer: Yangtse Su <yangtsesu at gmail dot com>
# SPDX-FileCopyrightText: 2026 Yangtse Su <yangtsesu@gmail.com>
# SPDX-License-Identifier: 0BSD
#
# The `-git` suffix means this package tracks the tip of the `main` branch. A release build from a
# tag lives next to this one as `cirrocast`. `makepkg -u --noextract` fetches the new commits and
# `makepkg -sif` rebuilds.
#
# Every bump is verified with:
#   namcap PKGBUILD
#   makepkg -f && namcap cirrocast-git-*.pkg.tar.zst
#   cirrocast-git --version && man -w cirrocast && pacman -Ql cirrocast-git | grep -c completions  # 3
# prepare() also rebuilds the bundled city table from the GeoNames cities15000 dump, so the table in
# this package is newer than the one committed with the upstream tag.

pkgname=cirrocast-git
pkgver=1.2.0.r20.g06aa8fd
pkgrel=1
pkgdesc="Terminal weather client with pluggable backends and wttr.in-style output"
arch=('x86_64' 'aarch64')
url="https://github.com/YangtseSu/cirrocast"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'jq' 'rust')
provides=('cirrocast')
conflicts=('cirrocast')
options=('!lto' '!debug')

# The bundled city table. The release package ships the snapshot that was committed with the tag;
# this `-git` package rebuilds the table on every run, so a rebuild picks up the cities and keys
# that GeoNames added since the last release. The dump is a source entry, so `makepkg` downloads it
# before prepare() and the build itself needs no network.
_geodumpname=cities15000.zip

source=("$pkgname::git+https://github.com/YangtseSu/cirrocast.git"
        "$_geodumpname::https://download.geonames.org/export/dump/cities15000.zip")
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$pkgname"
  # Rebuilds `src/geo/data` from the downloaded dump with the tool the developer runs by hand. The
  # binary embeds those files with `include_bytes!`, so the refresh must happen before build().
  cargo run --release --locked --target "$(_triple)" -p geo-table -- \
    "$srcdir/$_geodumpname" src/geo/data

  # A truncated download would still decode into a table that silently misses rows. The SNAPSHOT
  # record is written only after a complete pass, so its row count is the proof.
  local rows
  rows="$(sed -n 's/^rows = //p' src/geo/data/SNAPSHOT)"
  if [[ -z "$rows" || "$rows" -lt 30000 ]]; then
    printf 'cirrocast-git: geo refresh produced %s rows, the dump is incomplete\n' "${rows:-none}" >&2
    exit 1
  fi
  printf 'cirrocast-git: geo table refreshed (%s rows)\n' "$rows"
}

# Rust's target triple for both supported architectures is exactly `<arch>-unknown-linux-gnu`, and
# `$CARCH` already holds the architecture, so nothing has to be mapped by hand. There is no
# cross-compilation here: the crate builds with its own toolchain for the machine makepkg runs on.
_triple() {
  echo "${CARCH}-unknown-linux-gnu"
}

pkgver() {
  cd "$pkgname"
  git describe --long --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$pkgname"
  cargo build --release --locked --target "$(_triple)"
}

check() {
  cd "$pkgname"
  # The crate version must be the release this PKGBUILD is based on. A commit from a branch or a
  # merge that bumped the version fails here instead of shipping a package whose metadata lies.
  local built
  # By name: the workspace has a second member (the dev-only `geo-table` builder) and `packages[0]`
  # resolves to that one.
  built="$(cargo metadata --format-version 1 --no-deps \
    | jq -r '.packages[] | select(.name == "cirrocast") | .version')"
  # A mismatch is not a packaging error: `pkgver()` counts commits from the last tag, and
  # `Cargo.toml` can move ahead of that tag before the next release. The stable `cirrocast`
  # package makes the same check fatal.
  if [[ "$built" != "${pkgver%%.r*}" ]]; then
    printf 'cirrocast-git: crate version is %s, last tag is %s\n' "$built" "${pkgver%%.r*}" >&2
  fi
  cargo test --release --locked
}

package() {
  cd "$pkgname"
  local bin="target/$(_triple)/release/cirrocast"

  install -Dm755 "$bin" "$pkgdir/usr/bin/cirrocast"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The man page and the completions are generated by the binary itself, so they can never drift
  # from the command line surface they document.
  "$bin" man > "$srcdir/cirrocast.1"
  install -Dm644 "$srcdir/cirrocast.1" "$pkgdir/usr/share/man/man1/cirrocast.1"

  "$bin" completion bash > "$srcdir/cirrocast.bash"
  install -Dm644 "$srcdir/cirrocast.bash" \
    "$pkgdir/usr/share/bash-completion/completions/cirrocast"
  "$bin" completion zsh > "$srcdir/_cirrocast"
  install -Dm644 "$srcdir/_cirrocast" "$pkgdir/usr/share/zsh/site-functions/_cirrocast"
  "$bin" completion fish > "$srcdir/cirrocast.fish"
  install -Dm644 "$srcdir/cirrocast.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/cirrocast.fish"
}