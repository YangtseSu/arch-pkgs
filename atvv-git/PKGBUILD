# One pkgbase for the daemon/CLI/MCP and the GTK app. One Cargo invocation
# builds both, so the shared dependency graph is compiled once. Tracks the
# default branch; the tagged release package is `atvv` in the AUR.

pkgbase=atvv-git
pkgname=('atvv-git' 'atvv-gui-git')
pkgver=0.3.1.r2.g72835d4
pkgrel=2
arch=('x86_64' 'aarch64')
url='https://github.com/YangtseSu/atvv-linux'
license=('GPL-3.0-or-later')
# clang: bindgen generates the PipeWire/SPA bindings. The -sys crates probe
# their pkg-config modules (libpipewire-0.3, libspa-0.2, dbus-1, gtk4,
# libadwaita-1, gdk-pixbuf-2.0, pango, cairo, graphene-gobject-1.0, gio-2.0);
# each module's package is either named here or pulled in by one of these
# (gtk4 alone brings glib2, cairo, pango, gdk-pixbuf2, graphene and systemd-libs).
# pkgconf comes from base-devel. Nothing reads bluez.pc, so bluez stays a
# runtime-only entry.
makedepends=('clang' 'dbus' 'git' 'gtk4' 'libadwaita' 'libpipewire' 'rust')
options=('!debug')
source=("$pkgbase::git+https://github.com/YangtseSu/atvv-linux.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgbase"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$pkgbase"
  cargo fetch --locked
}

build() {
  cd "$pkgbase"
  cargo build --release --offline --locked \
    -p atvv-daemon -p atvv-cli -p atvv-mcp -p atvv-gui --bins
}

# No check(): the project CI owns the workspace tests.

package_atvv-git() {
  pkgdesc='Bluetooth voice remote userspace stack (git)'
  # Direct NEEDED entries plus the two services the binaries talk to: atvvd owns
  # the Audio/Source on the PipeWire graph and the GATT transport over bluez'
  # bluetoothd, so both are runtime requirements, not transitive ones. Each
  # linked soname (libdbus-1.so.3, libpipewire-0.3.so.0, libc) comes from a
  # package named here, so the soname is not repeated in the array.
  depends=(
    bluez
    dbus
    glibc
    libgcc
    libpipewire
    pipewire
  )
  # `atvvctl record --wav` shells out to pw-cat, which ships in pipewire-audio.
  optdepends=('pipewire-audio: capture diagnostics through pw-cat')
  provides=("atvv=$pkgver")
  conflicts=('atvv')
  cd "$pkgbase"

  install -Dm755 target/release/atvvd "$pkgdir/usr/bin/atvvd"
  install -Dm755 target/release/atvvctl "$pkgdir/usr/bin/atvvctl"
  install -Dm755 target/release/atvv-mcp "$pkgdir/usr/bin/atvv-mcp"

  install -Dm644 packaging/systemd/atvvd.service \
    "$pkgdir/usr/lib/systemd/user/atvvd.service"
  install -Dm644 packaging/udev/70-atvv-linux.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-atvv-linux.rules"
  install -Dm644 packaging/modules-load.d/atvv-linux.conf \
    "$pkgdir/usr/lib/modules-load.d/atvv-linux.conf"

  install -d "$pkgdir/usr/share/man/man1"
  ./target/release/atvvctl manpages "$pkgdir/usr/share/man/man1"
  install -m644 packaging/man/atvv-mcp.1 "$pkgdir/usr/share/man/man1/atvv-mcp.1"

  install -d "$pkgdir/usr/share/bash-completion/completions"
  ./target/release/atvvctl completions bash \
    >"$pkgdir/usr/share/bash-completion/completions/atvvctl"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  ./target/release/atvvctl completions zsh \
    >"$pkgdir/usr/share/zsh/site-functions/_atvvctl"
  install -d "$pkgdir/usr/share/fish/vendor_completions.d"
  ./target/release/atvvctl completions fish \
    >"$pkgdir/usr/share/fish/vendor_completions.d/atvvctl.fish"

  # The whole docs tree, not a hand-picked list: the guides cross-reference
  # decisions/, plans/, research/ and acceptance/, so a subset would ship
  # dangling links and would need editing on every upstream doc rename.
  install -d "$pkgdir/usr/share/doc/$pkgname"
  cp -r README.md README.zh-CN.md docs "$pkgdir/usr/share/doc/$pkgname/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
}

package_atvv-gui-git() {
  pkgdesc='GTK4/libadwaita configuration app for ATVV remotes (git)'
  # Direct NEEDED entries plus the daemon, which owns the D-Bus API this app
  # drives; `atvv-config` renders nothing but that API. librsvg arrives through
  # gtk4 for the SVG icon, so it is not listed on its own. Each linked soname
  # (libgtk-4.so.1, libadwaita-1.so.0, libgraphene-1.0.so.0, libgio/libglib/
  # libgobject) comes from a package named here.
  depends=(
    "atvv-git=$pkgver"
    glib2
    glibc
    graphene
    gtk4
    hicolor-icon-theme
    libadwaita
    libgcc
  )
  provides=("atvv-gui=$pkgver")
  conflicts=('atvv-gui')
  cd "$pkgbase"

  install -Dm755 target/release/atvv-config "$pkgdir/usr/bin/atvv-config"
  install -Dm644 packaging/gui/org.atvv.Config.desktop \
    "$pkgdir/usr/share/applications/org.atvv.Config.desktop"
  install -Dm644 packaging/gui/org.atvv.Config.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.atvv.Config.metainfo.xml"
  install -Dm644 packaging/gui/org.atvv.Config.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.atvv.Config.svg"

  # No documentation here: docs/gui.md and its screenshots ship in atvv-git,
  # which this package already requires, so README's link resolves for either
  # install order. The license text is repeated because the app is a separate
  # binary and must carry its own copy.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
}
