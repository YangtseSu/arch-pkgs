# Maintainer: Yangtse Su <yangtsesu at gmail dot com>
# SPDX-FileCopyrightText: 2026 Yangtse Su <yangtsesu@gmail.com>
# SPDX-License-Identifier: 0BSD
#
# Builds from source the fork at github.com/YangtseSu/zju-connect: the upstream project plus every
# change of ours, integrated on the fork's `dev` branch, its default branch. The `-git` suffix means
# the tip of that branch, so `makepkg -C --noconfirm` re-clones it and picks up new commits (`-e`
# would silently keep the old checkout). A single change still leaves the fork as a topic branch cut
# from upstream's `main`, so it can open its own pull request; `dev` is where the topic branches
# meet for daily use.
#
# Verified with:
#   namcap PKGBUILD
#   makepkg -f && namcap zju-connect-git-*.pkg.tar.zst
# namcap keeps one warning: the cgo-enabled build links libresolv.so.2 through glibc's resolver
# symbols, which the binary does not call. A cgo-less build removes the warning but drops FULL
# RELRO and adds a needless glibc dependency, so this trade is the better one.
#
# The layout follows archlinuxcn's `zju-connect-bin` (binary in /usr/bin, the sample configuration
# as /etc/zju-connect/config.toml, a systemd unit), but the binary is compiled here instead of
# unpacked from a release archive. `provides=('zju-connect-bin')` exists so that the archlinuxcn
# `ez4connect` package keeps a satisfied dependency when this package replaces that one.

pkgname=zju-connect-git
pkgver=1.3.1.r80.g9889ff6
pkgrel=1
pkgdesc='Go client for the ZJU RVPN and Sangfor aTrust gateways'
arch=('x86_64' 'aarch64')
url='https://github.com/YangtseSu/zju-connect'
license=('AGPL-3.0-only')
depends=('glibc')
makedepends=('gcc' 'git' 'go')
provides=('zju-connect' 'zju-connect-bin')
conflicts=('zju-connect-bin')
backup=('etc/zju-connect/config.toml')
options=('!debug')
_branch=dev
source=("$pkgname::git+$url.git#branch=$_branch"
        'zju-connect.service')
sha256sums=('SKIP'
            '96f9145b783e770d6c448d9db7e43796b79c19f984f2b1387333a64c1874a74a')

prepare() {
  cd "$pkgname"
  # Fetch modules here so build() needs no network: a clean chroot has none once checksumming and
  # cloning are done.
  #
  # One module comes from the canonical proxy instead of the configured one. The GOPROXY of this
  # environment, mirrors.aliyun.com, serves golang.zx2c4.com/wireguard/windows@v1.0.1 with hash
  # h1:zRLGRx84kiOcxqkYLoeKYCQNBO2tKYOKXu7AvlSZ6h4=, while go.sum and sum.golang.org both require
  # h1:eOxiDVbywPC+ZQqvdCK7x+ZwWXKbYv50TtH8ysFIbw8=: the mirror cached a different build of that
  # tag (its .info reports 2026-04-20T11:32:47Z against the official 11:14:21Z). A checksum
  # mismatch does not fall through to the next proxy of a GOPROXY list, so the module is fetched
  # here, from proxy.golang.org; the second call then takes every module from the mirror and the
  # cache.
  GOPROXY="https://proxy.golang.org,direct" go mod download golang.zx2c4.com/wireguard/windows
  go mod download
}

pkgver() {
  cd "$pkgname"
  # Fork release tags (`v1.3.1-fork.1`) name a snapshot of this branch, not an
  # upstream release; ignoring them keeps the `-git` version ordered by the
  # upstream tags alone, so a rebuild from a release tag yields the same pkgver
  # as one from the branch tip.
  git describe --tags --long --abbrev=7 --match 'v*' --exclude '*-fork*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$pkgname"
  # cgo is on so the external linker can apply the hardening flags below; a cgo-less build cannot
  # use -linkmode=external.
  export CGO_ENABLED=1
  go build \
    -trimpath \
    -buildmode=pie \
    -ldflags "-s -w \
      -X main.zjuConnectVersion=${pkgver%%.r*} \
      -X main.CommitID=$(git rev-parse --short HEAD) \
      -linkmode=external -extldflags=-Wl,-z,relro,-z,now" \
    -o zju-connect \
    .
}

check() {
  cd "$pkgname"
  go test ./...
}

package() {
  cd "$pkgname"
  install -Dm755 zju-connect "$pkgdir/usr/bin/zju-connect"

  # The upstream sample, installed as the live configuration: the systemd unit reads this path, and
  # it is in `backup` so an upgrade keeps the user's edits.
  install -Dm644 config.toml.example "$pkgdir/etc/zju-connect/config.toml"

  install -Dm644 "$srcdir/zju-connect.service" \
    "$pkgdir/usr/lib/systemd/system/zju-connect.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
